pipeline {
  agent any

  environment {
    PATH = "/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin"
  }

  options {
    timestamps()
    ansiColor('xterm')
  }

  stages {
    stage('Install') {
      steps {
        dir('sci-calc-next') {
          sh 'node -v'
          sh 'rm -rf node_modules'
          sh 'npm ci'
        }
      }
    }

    stage('Test') {
      steps {
        dir('sci-calc-next') {
          sh 'npm run lint'
          sh 'npm run test'
        }
      }
    }

    stage('Build') {
      steps {
        dir('sci-calc-next') {
          sh 'NODE_ENV=production npm run build'
        }
      }
    }

    stage('Docker Build & Push') {
      steps {
        dir('sci-calc-next') {
          script {
            withCredentials([
              usernamePassword(
                credentialsId: 'dockerhub',
                usernameVariable: 'DOCKERHUB_USER',
                passwordVariable: 'DOCKERHUB_TOKEN'
              )
            ]) {
              def image = "${DOCKERHUB_USER}/sci-calc-next:latest"
              env.DOCKER_IMAGE = image
              sh """
                #!/bin/bash
                set -eux
                echo "Using Docker Hub user: ${DOCKERHUB_USER}"
                echo "${DOCKERHUB_TOKEN}" | docker login -u "${DOCKERHUB_USER}" --password-stdin
                docker build -t "${image}" .
                docker push "${image}"
                docker logout
              """
            }
          }
        }
      }
    }

    stage('Ansible Deploy') {
      steps {
        dir('sci-calc-next') {
          script {
            withCredentials([
              string(credentialsId: 'ANSIBLE_VAULT_PASS', variable: 'ANSIBLE_VAULT_PASS')
            ]) {
              def candidatePorts = ['3000', '3300', '3400']
              def selectedPort = null
              for (port in candidatePorts) {
                if (sh(script: "lsof -i :${port}", returnStatus: true) != 0) {
                  selectedPort = port
                  break
                } else {
                  echo "Port ${port} is busy, checking next option"
                }
              }
              if (selectedPort == null) {
                error("No available host ports found from ${candidatePorts.join(', ')}")
              }
              echo "Using host port ${selectedPort} for deployment"
              env.DEPLOY_HOST_PORT = selectedPort
              withEnv([
                "DOCKER_IMAGE=${env.DOCKER_IMAGE ?: ''}",
                "HOST_PORT=${selectedPort}"
              ]) {
                sh '''
                  set -eux
                  python3 -m venv .venv
                  VENV_PATH="$(pwd)/.venv"
                  . "$VENV_PATH/bin/activate"
                  pip install --upgrade pip ansible docker
                  export ANSIBLE_PYTHON_INTERPRETER="$VENV_PATH/bin/python"
                  cd ansible
                  ansible-galaxy collection install -r requirements.yml
                  trap 'rm -f .vault_pass.txt' EXIT
                  printf "%s" "$ANSIBLE_VAULT_PASS" > .vault_pass.txt
                  ansible-playbook playbooks/deploy.yml --vault-password-file .vault_pass.txt
                '''
              }
            }
          }
        }
      }
    }
  }

  post {
    success {
      script {
        if (env.NOTIFY_EMAILS?.trim()) {
          emailext(
            to: env.NOTIFY_EMAILS,
            subject: "SciCalc Next build #${env.BUILD_NUMBER} succeeded",
            mimeType: 'text/html',
            body: """<p>Build <a href='${env.BUILD_URL}'>#${env.BUILD_NUMBER}</a> completed successfully.</p>
<p>Docker image: ${env.DOCKER_IMAGE ?: 'n/a'}<br/>Host port: ${env.DEPLOY_HOST_PORT ?: '3000'}</p>"""
          )
        }
      }
    }
    failure {
      echo 'Pipeline failed. Review the logs for details.'
      script {
        if (env.NOTIFY_EMAILS?.trim()) {
          emailext(
            to: env.NOTIFY_EMAILS,
            subject: "SciCalc Next build #${env.BUILD_NUMBER} failed",
            mimeType: 'text/html',
            body: """<p>Build <a href='${env.BUILD_URL}'>#${env.BUILD_NUMBER}</a> failed.</p>
<p>Review the <a href='${env.BUILD_URL}console'>console log</a> for details.</p>""",
            attachLog: true
          )
        }
      }
    }
  }
}
